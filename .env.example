# ==========================================
# UPI Offline Mesh Environment Configuration
# ==========================================

# Spring Boot Settlement Engine
SERVER_PORT=8080
UPI_MESH_IDEMPOTENCY_TTL_SECONDS=86400
UPI_MESH_PACKET_MAX_AGE_SECONDS=86400

# Supabase PostgreSQL Database (Production Persistence on Render)
# If omitted or running locally, seamlessly defaults to H2 in-memory DB: jdbc:h2:mem:upimesh
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_db_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Next.js Frontend Dashboard (Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8080/api
BACKEND_INTERNAL_URL=http://backend:8080

# Supabase Client & Realtime WebSockets (Frontend on Vercel)
# Get from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# FastAPI Edge Gateway
GATEWAY_PORT=8000
BACKEND_URL=http://localhost:8080

# Groq AI Assistant (Streaming Interactive Chatbot)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
