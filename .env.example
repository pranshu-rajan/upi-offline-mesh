# ==========================================
# UPI Offline Mesh Environment Configuration
# ==========================================

# Spring Boot Settlement Engine
SERVER_PORT=8080
UPI_MESH_IDEMPOTENCY_TTL_SECONDS=86400
UPI_MESH_PACKET_MAX_AGE_SECONDS=86400

# Next.js Frontend Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8080/api
BACKEND_INTERNAL_URL=http://backend:8080

# FastAPI Edge Gateway
GATEWAY_PORT=8000
BACKEND_URL=http://localhost:8080

# Groq AI Assistant (Streaming Interactive Chatbot)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
